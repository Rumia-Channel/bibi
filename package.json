{
  "name": "bibi",
  "version": "2.0.0-alpha",
  "author": {
    "name": "Satoru Matsushima"
  },
  "description": "Bibi | EPUB Reader on your website.",
  "keywords": [
    "EPUB",
    "Reading System",
    "Viewer",
    "Books-in-Browsers"
  ],
  "license": "MIT",
  "homepage": "https://bibi.epub.link",
  "repository": {
    "type": "git",
    "url": "git://github.com/satorumurmur/bibi.git"
  },
  "bugs": "https://github.com/satorumurmur/bibi/issues",
  "readmeFilename": "README.md",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "zzz"
  ],
  "scripts": {
    "clean": "zzz --clean",
    "develop": "zzz --clean --weave development && webpack --progress --config-name development && zzz --wove development",
    "develop+watch": "zzz --clean --weave development+watch && webpack --progress --config-name development --watch",
    "develop@wbck": "zzz --clean --weave development@wbck && webpack --progress --config-name development@wbck && zzz --wove development@wbck",
    "develop@wbck+watch": "zzz --clean --weave development@wbck+watch && webpack --progress --config-name development@wbck --watch",
    "build": "zzz --clean --weave production && webpack --progress --config-name production && zzz --wove production",
    "build+watch": "zzz --clean --weave production+watch && webpack --progress --config-name production --watch",
    "build@wbck": "zzz --clean --weave production@wbck && webpack --progress --config-name production@wbck && zzz --wove production@wbck",
    "build@wbck+watch": "zzz --clean --weave production@wbck+watch && webpack --progress --config-name production@wbck --watch",
    "make:dress-template": "zzz --make:dress-template",
    "archive": "zzz --clean tmp --weave archive && webpack --progress --config-name archive && zzz --archive",
    "archive@wbck": "zzz --clean tmp --weave archive@wbck && webpack --progress --config-name archive@wbck && zzz --archive wbck",
    "serve": "webpack serve --progress --config-name development",
    "demo": "bun run build@wbck && bun run serve",
    "start": "bun run develop+watch",
    "test": "bun test"
  },
  "devDependencies": {
    "zzz": "workspace:*",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.0.3",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^11.5.1",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.2",
    "webpack-fix-style-only-entries": "^0.6.1"
  },
  "dependencies": {
    "bibi-zip-loader": "^0.9.0",
    "dompurify": "^3.3.0",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "material-symbols": "0.35.1",
    "nosleep.js": "^0.12.0",
    "sml.js": "^3.0.0"
  },
  "overrides": {
    "immutable": "^4.3.9",
    "qs": "^6.16.0"
  },
  "browserslist": [
    "last 3 major versions",
    "not dead"
  ]
}
